# Copy to .env.live, replace every placeholder, and chmod 600.
JARVIS_ENVIRONMENT=dev
JARVIS_TFSTATE_BUCKET=REPLACE_WITH_TERRAFORM_STATE_BUCKET

TF_VAR_project_id=REPLACE_WITH_DEV_PROJECT_ID
TF_VAR_region=us-central1
TF_VAR_zone=us-central1-a
TF_VAR_bucket_name=REPLACE_WITH_DEV_DATA_BUCKET
TF_VAR_airflow_log_bucket_name=REPLACE_WITH_DEV_AIRFLOW_LOG_BUCKET
TF_VAR_scratch_bucket_name=REPLACE_WITH_DEV_SCRATCH_BUCKET
TF_VAR_backup_bucket_name=REPLACE_WITH_DEV_BACKUP_BUCKET
TF_VAR_billing_account_id=REPLACE_WITH_BILLING_ACCOUNT_ID
TF_VAR_alert_email=REPLACE_WITH_VERIFIED_OPERATIONS_EMAIL
TF_VAR_monthly_budget_usd=REPLACE_WITH_APPROVED_DEV_MONTHLY_BUDGET_USD
TF_VAR_deployer_principals='["group:REPLACE_WITH_PLATFORM_GROUP"]'
TF_VAR_operator_principals='["group:REPLACE_WITH_OPERATOR_GROUP"]'
TF_VAR_github_repository=REPLACE_WITH_GITHUB_OWNER/REPLACE_WITH_GITHUB_REPOSITORY
TF_VAR_github_repository_id=REPLACE_WITH_NUMERIC_GITHUB_REPOSITORY_ID
TF_VAR_github_repository_owner_id=REPLACE_WITH_NUMERIC_GITHUB_OWNER_ID
TF_VAR_shared_storage_buckets='{}'
TF_VAR_shared_bigquery_datasets='{}'
TF_VAR_host_images='{"control":"projects/REPLACE_WITH_DEV_PROJECT_ID/global/images/REPLACE_WITH_IMMUTABLE_CONTROL_HOST_IMAGE","feed":"projects/REPLACE_WITH_DEV_PROJECT_ID/global/images/REPLACE_WITH_IMMUTABLE_FEED_HOST_IMAGE","notebook":"projects/REPLACE_WITH_DEV_PROJECT_ID/global/images/REPLACE_WITH_IMMUTABLE_NOTEBOOK_HOST_IMAGE"}'
# Set temporarily to control, feed, or notebook only during its three-step replacement.
# TF_VAR_host_replacement_role=control

# Preferred: ADC plus short-lived impersonation. These are identity names, not secrets.
# Enable these after the initial apply and state-bucket IAM handoff.
# GOOGLE_IMPERSONATE_SERVICE_ACCOUNT=research-dev-deployer@REPLACE_WITH_DEV_PROJECT_ID.iam.gserviceaccount.com
# GOOGLE_BACKEND_IMPERSONATE_SERVICE_ACCOUNT=research-dev-deployer@REPLACE_WITH_DEV_PROJECT_ID.iam.gserviceaccount.com
# GOOGLE_APPLICATION_CREDENTIALS=/secure/path/to/gcp-credential-configuration.json
