# Copy to .env.live, replace every placeholder, and chmod 600.
JARVIS_ENVIRONMENT=prod
JARVIS_TFSTATE_BUCKET=REPLACE_WITH_TERRAFORM_STATE_BUCKET

TF_VAR_project_id=REPLACE_WITH_PROD_PROJECT_ID
TF_VAR_region=us-central1
TF_VAR_zone=us-central1-a
TF_VAR_bucket_name=REPLACE_WITH_PROD_DATA_BUCKET

# Preferred: ADC plus short-lived impersonation. These are identity names, not secrets.
# GOOGLE_IMPERSONATE_SERVICE_ACCOUNT=jarvis-prod-deployer@REPLACE_WITH_PROD_PROJECT_ID.iam.gserviceaccount.com
# GOOGLE_BACKEND_IMPERSONATE_SERVICE_ACCOUNT=jarvis-prod-deployer@REPLACE_WITH_PROD_PROJECT_ID.iam.gserviceaccount.com
# GOOGLE_APPLICATION_CREDENTIALS=/secure/path/to/gcp-credential-configuration.json
