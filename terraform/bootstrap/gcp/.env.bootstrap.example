# Copy to .env.bootstrap, replace every placeholder, and chmod 600.
# This file uses shell syntax because scripts/bootstrap-gcp-state.sh sources it.

TF_VAR_project_id=REPLACE_WITH_GCP_PROJECT_ID
TF_VAR_bucket_name=REPLACE_WITH_GLOBALLY_UNIQUE_BUCKET_NAME
TF_VAR_location=US

# Use the administrator group for initial creation. After each live root creates
# its deployer, add that research-ENV-deployer service account and remove human
# state write access when the operational handoff is complete.
TF_VAR_state_writer_principals='["group:platform-admins@example.com"]'
TF_VAR_bucket_admin_principals='["group:platform-admins@example.com"]'
TF_VAR_state_reader_principals='["group:security-auditors@example.com"]'
# Populate after staging emits its recovery service-account address.
TF_VAR_state_recovery_principals='[]'

TF_VAR_state_version_retention_days=365
TF_VAR_soft_delete_retention_days=14
TF_VAR_labels='{"owner":"platform","environment":"shared"}'

# Preferred authentication: first establish Application Default Credentials,
# then impersonate a short-lived bootstrap identity. These values are identity
# names, not secrets.
# GOOGLE_IMPERSONATE_SERVICE_ACCOUNT=jarvis-bootstrap@REPLACE_WITH_GCP_PROJECT_ID.iam.gserviceaccount.com
# GOOGLE_BACKEND_IMPERSONATE_SERVICE_ACCOUNT=jarvis-bootstrap@REPLACE_WITH_GCP_PROJECT_ID.iam.gserviceaccount.com

# If a local or federated credential configuration file is required, reference
# its protected path; never paste JSON credential contents into this env file.
# GOOGLE_APPLICATION_CREDENTIALS=/secure/path/to/gcp-credential-configuration.json
