# ===========================================================================
# Copy to .env and fill in ONE provider block. .env is gitignored; chmod 600.
# Nothing secret belongs here in production -- use the provider's secret store.
# ===========================================================================

RP_ENV=dev

# ---------------------------------------------------------------------------
# Storage. This single setting determines the provider; RP_CLOUD is optional
# and only worth setting if you want a loud failure on a mismatch.
# ---------------------------------------------------------------------------
#   GCP    RP_STORAGE_URI=gs://my-research-bucket
#   AWS    RP_STORAGE_URI=s3://my-research-bucket
#   Azure  RP_STORAGE_URI=abfs://research@myaccount.dfs.core.windows.net
RP_STORAGE_URI=gs://my-research-bucket
# RP_CLOUD=gcp

# Local development: bypasses object storage entirely. Never set in prod.
# RP_LOCAL_ROOT=/tmp/research-data

# ---------------------------------------------------------------------------
# --- GCP --------------------------------------------------------------------
# ---------------------------------------------------------------------------
RP_PROJECT_ID=my-gcp-project
RP_REGION=us-central1
RP_BATCH_JOB_NAME=research-job
IMAGE=us-central1-docker.pkg.dev/my-gcp-project/research/base

# ---------------------------------------------------------------------------
# --- AWS --------------------------------------------------------------------
# ---------------------------------------------------------------------------
# RP_REGION=us-east-1
# RP_BATCH_JOB_NAME=research-job          # Batch job DEFINITION name
# RP_BATCH_JOB_QUEUE=research-queue
# IMAGE=123456789012.dkr.ecr.us-east-1.amazonaws.com/research/base

# ---------------------------------------------------------------------------
# --- Azure ------------------------------------------------------------------
# ---------------------------------------------------------------------------
# RP_REGION=eastus
# RP_RESOURCE_GROUP=research-prod
# RP_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
# RP_AZURE_ACI_SUBNET_ID=/subscriptions/.../subnets/research-aci
# RP_AZURE_JOB_IDENTITY_ID=/subscriptions/.../userAssignedIdentities/research-prod-job
# IMAGE=myregistry.azurecr.io/research/base

# ---------------------------------------------------------------------------
# Image tag. Written by CI / ctl deploy. Always a SHA in production.
# ---------------------------------------------------------------------------
IMAGE_TAG=latest

# ---------------------------------------------------------------------------
# Airflow -- provider-neutral
# ---------------------------------------------------------------------------
AIRFLOW_HOME=/opt/airflow
AIRFLOW_DB_HOST=127.0.0.1
AIRFLOW_DB_PORT=5432
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=changeme
AIRFLOW_DB_NAME=airflow
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=

# Remote log destination. Must match the provider implied by RP_STORAGE_URI:
#   GCP    gs://my-research-bucket/airflow-logs
#   AWS    s3://my-research-bucket/airflow-logs
#   Azure  wasb://airflow-logs@myaccount.blob.core.windows.net
AIRFLOW_REMOTE_LOGS=gs://my-research-bucket/airflow-logs
# Leave unset to use the provider default (google_cloud_default / aws_default /
# wasb_default).
# AIRFLOW_LOG_CONN_ID=

# Secrets backend kwargs, provider-specific JSON. Leave blank to disable.
#   GCP   {"project_id":"my-gcp-project","connections_prefix":"airflow-connections","sep":"-"}
#   AWS   {"connections_prefix":"airflow/connections","variables_prefix":"airflow/variables"}
#   Azure {"vault_url":"https://myvault.vault.azure.net/","connections_prefix":"airflow-connections"}
AIRFLOW_SECRETS_BACKEND=airflow.providers.google.cloud.secrets.secret_manager.CloudSecretManagerBackend
AIRFLOW_SECRETS_KWARGS={"project_id":"my-gcp-project","connections_prefix":"airflow-connections","sep":"-"}

# ---------------------------------------------------------------------------
# Deploy targets (used by ctl)
# ---------------------------------------------------------------------------
SSH_USER=
CONTROL_HOST=
FEED_HOST=
NOTEBOOK_HOST=

# ---------------------------------------------------------------------------
# Feed
# ---------------------------------------------------------------------------
RP_FEED_WS_URL=wss://example.invalid/ws
RP_FEED_SOURCE=example
RP_FEED_DATASET=ticks
RP_FEED_FLUSH_SECONDS=60
RP_FEED_FLUSH_ROWS=10000

RP_ALERT_EMAILS=
RP_TIMEZONE=UTC
