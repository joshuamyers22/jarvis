#!/usr/bin/env bash
# Supervise one Jarvis Compose role. Installed at /usr/local/sbin/jarvis-compose.
set -euo pipefail

export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

root=${JARVIS_ROOT:-/opt/research}
health_interval=${JARVIS_HEALTH_INTERVAL_SECONDS:-30}
health_failures_allowed=${JARVIS_HEALTH_FAILURES_ALLOWED:-2}
start_timeout=${JARVIS_START_TIMEOUT_SECONDS:-180}
migration_timeout=${JARVIS_MIGRATION_TIMEOUT_SECONDS:-1860}

usage() {
  echo "usage: jarvis-compose <validate|candidate-preflight|image-reference|supervise|stop|health|wait|migration-preflight|migration-current|schema-current|migrate> <control|feed|notebook> [wait-seconds]" >&2
  exit 2
}

[[ $# -ge 2 && $# -le 3 ]] || usage
action=$1
role=$2
case "$action" in
  validate | candidate-preflight | image-reference | supervise | stop | health | wait | migration-preflight | migration-current | schema-current | migrate) ;;
  *) usage ;;
esac
case "$role" in
  control | feed | notebook) ;;
  *)
    echo "unsupported Jarvis role: $role" >&2
    exit 2
    ;;
esac
case "$action" in
  migration-preflight | migration-current | schema-current | migrate)
    [[ "$role" == "control" ]] || {
      echo "database migration actions require the control role" >&2
      exit 2
    }
    ;;
esac

role_dir="${root}/${role}"
runtime_env="${role_dir}/runtime.env"
tag_env="${role_dir}/.env.tag"
candidate_tag_env="${role_dir}/.env.candidate-tag"
migration_tag_env="${role_dir}/.env.migration-tag"
compose_file="${role_dir}/compose/${role}.yml"
systemd_compose_file="${role_dir}/compose/${role}.systemd.yml"
candidate_runtime_env="${role_dir}/runtime.candidate.env"
candidate_compose_file="${role_dir}/compose.candidate/${role}.yml"
candidate_systemd_compose_file="${role_dir}/compose.candidate/${role}.systemd.yml"
case "$action" in
  migration-preflight | migration-current | schema-current | migrate)
    docker_config=$(mktemp -d /run/jarvis-migration.XXXXXX)
    trap 'rm -rf -- "$docker_config"' EXIT
    ;;
  *) docker_config="/run/jarvis-${role}/docker" ;;
esac
export DOCKER_CONFIG="$docker_config"

json_health() {
  local healthy=$1
  local error=$2
  local services=$3
  if [[ "$healthy" == "true" ]]; then
    printf '{"schema_version":1,"role":"%s","healthy":true,"services":[%s]}\n' "$role" "$services"
  else
    printf '{"schema_version":1,"role":"%s","healthy":false,"error":"%s","services":[%s]}\n' "$role" "$error" "$services"
  fi
}

validate_layout_with_tag() {
  local selected_tag_env=$1
  local path mode
  for path in "$runtime_env" "$selected_tag_env" "$compose_file" "$systemd_compose_file"; do
    [[ -f "$path" ]] || {
      echo "missing required service file: $path" >&2
      return 1
    }
  done

  for path in "$runtime_env" "$selected_tag_env"; do
    mode=$(stat -c '%a' "$path")
    (( (8#$mode & 077) == 0 )) || {
      echo "service environment file must not be group/world accessible: $path" >&2
      return 1
    }
  done
}

validate_layout() {
  validate_layout_with_tag "$tag_env"
}

notebook_host_path() {
  local key value
  while IFS='=' read -r key value; do
    if [[ "$key" == "NOTEBOOKS_HOST_PATH" ]]; then
      printf '%s' "$value"
      return 0
    fi
  done <"$runtime_env"
}

env_value() {
  local wanted=$1
  local key value
  while IFS='=' read -r key value; do
    if [[ "$key" == "$wanted" ]]; then
      printf '%s' "$value"
      return 0
    fi
  done <"$runtime_env"
}

registry_login() {
  local image registry response token
  image=$(env_value IMAGE)
  registry=${image%%/*}
  case "$registry" in
    gcr.io | *.gcr.io | *.pkg.dev) ;;
    *) return 0 ;;
  esac

  response=$(curl --fail --silent --show-error \
    --connect-timeout 2 \
    --max-time 10 \
    --header 'Metadata-Flavor: Google' \
    'http://metadata.google.internal/computeMetadata/v1/instance/service-accounts/default/token')
  token=$(sed -nE 's/.*"access_token"[[:space:]]*:[[:space:]]*"([^"]+)".*/\1/p' <<<"$response")
  [[ -n "$token" ]] || {
    echo "metadata server returned no access token" >&2
    return 1
  }
  install -d -m 0700 "$docker_config"
  printf '%s' "$token" | docker login --username oauth2accesstoken --password-stdin "$registry" >/dev/null
  unset token response
}

compose_with_tag() {
  local selected_tag_env=$1
  shift
  local -a args
  args=(
    docker compose
    --project-name "jarvis-${role}"
    --env-file "$runtime_env"
    --env-file "$selected_tag_env"
    -f "$compose_file"
    -f "$systemd_compose_file"
  )

  if [[ "$role" == "notebook" ]]; then
    local host_path
    host_path=$(notebook_host_path)
    if [[ -n "$host_path" ]]; then
      [[ "$host_path" == /* ]] || {
        echo "NOTEBOOKS_HOST_PATH must be absolute" >&2
        return 1
      }
      [[ -d "$host_path" ]] && mountpoint -q -- "$host_path" || {
        echo "notebook storage is not a mounted directory: $host_path" >&2
        return 1
      }
      if [[ -x /usr/local/sbin/jarvis-notebook-storage ]]; then
        /usr/local/sbin/jarvis-notebook-storage verify "$host_path" >/dev/null
      fi
      args+=(-f "${role_dir}/compose/notebook.storage.yml")
    fi
  fi

  if [[ -n "${compose_timeout:-}" ]]; then
    timeout --foreground --kill-after=15s "$compose_timeout" "${args[@]}" "$@"
  else
    "${args[@]}" "$@"
  fi
}

compose() {
  compose_with_tag "$tag_env" "$@"
}

candidate_compose() {
  local runtime_env=$candidate_runtime_env
  local compose_file=$candidate_compose_file
  local systemd_compose_file=$candidate_systemd_compose_file
  compose_with_tag "$candidate_tag_env" "$@"
}

migration_compose() {
  compose_with_tag "$migration_tag_env" "$@"
}

health() {
  local quiet=${1:-false}
  local healthy=true
  local error=""
  local services_json=""
  local service cid state container_health service_healthy
  local services_output
  local -a services

  if ! validate_layout >/dev/null 2>&1; then
    [[ "$quiet" == "true" ]] || json_health false configuration-invalid ""
    return 1
  fi
  if ! services_output=$(compose config --services 2>/dev/null); then
    [[ "$quiet" == "true" ]] || json_health false compose-config-invalid ""
    return 1
  fi
  if [[ -z "$services_output" ]]; then
    [[ "$quiet" == "true" ]] || json_health false no-services ""
    return 1
  fi
  mapfile -t services <<<"$services_output"

  for service in "${services[@]}"; do
    cid=$(compose ps --all -q "$service" 2>/dev/null || true)
    state=missing
    container_health=none
    service_healthy=false
    if [[ -n "$cid" && "$cid" != *$'\n'* ]]; then
      state=$(docker inspect --format '{{.State.Status}}' "$cid" 2>/dev/null || printf unknown)
      container_health=$(docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' "$cid" 2>/dev/null || printf unknown)
      if [[ "$state" == "running" && ( "$container_health" == "healthy" || "$container_health" == "none" ) ]]; then
        service_healthy=true
      fi
    fi
    if [[ "$service_healthy" != "true" ]]; then
      healthy=false
      error=service-unhealthy
    fi
    [[ -z "$services_json" ]] || services_json+=,
    services_json+=$(printf '{"name":"%s","state":"%s","health":"%s","healthy":%s}' \
      "$service" "$state" "$container_health" "$service_healthy")
  done

  [[ "$quiet" == "true" ]] || json_health "$healthy" "$error" "$services_json"
  [[ "$healthy" == "true" ]]
}

start_project() {
  local deadline remaining
  validate_layout
  compose config --quiet
  registry_login
  deadline=$((SECONDS + start_timeout))
  compose_timeout="${start_timeout}s" compose pull
  remaining=$((deadline - SECONDS))
  (( remaining > 0 )) || {
    echo "service start budget exhausted while pulling images" >&2
    return 1
  }
  compose_timeout="${remaining}s" compose up -d --remove-orphans --wait --wait-timeout "$remaining"
}

stop_project() {
  local -a containers
  mapfile -t containers < <(
    docker ps \
      --filter "label=com.docker.compose.project=jarvis-${role}" \
      --quiet
  )
  if (( ${#containers[@]} > 0 )); then
    docker stop --timeout 30 "${containers[@]}"
  fi
}

run_migration_container() {
  local selected_tag_env=$1
  local command=$2
  local timeout_seconds=$3
  local compose_function=$4
  validate_layout_with_tag "$selected_tag_env"
  "$compose_function" config --quiet
  registry_login
  compose_timeout="${start_timeout}s" "$compose_function" pull migration
  compose_timeout="${timeout_seconds}s" \
    "$compose_function" run --rm --no-deps migration "$command"
}

candidate_preflight() {
  local expected_cloud image_cloud image_reference expected_digest
  local -a images
  local runtime_env=$candidate_runtime_env
  local compose_file=$candidate_compose_file
  local systemd_compose_file=$candidate_systemd_compose_file
  validate_layout_with_tag "$candidate_tag_env"
  candidate_compose config --quiet
  registry_login
  compose_timeout="${start_timeout}s" candidate_compose pull
  mapfile -t images < <(candidate_compose config --images | sort -u)
  (( ${#images[@]} == 1 )) || {
    echo "candidate must resolve to exactly one image" >&2
    return 1
  }
  image_reference=${images[0]}
  expected_digest=$(sed -n 's/^IMAGE_DIGEST=//p' "$candidate_tag_env")
  [[ "$image_reference" == *@"$expected_digest" ]] || {
    echo "candidate image is not pinned to the selected digest" >&2
    return 1
  }
  expected_cloud=$(env_value RP_CLOUD)
  image_cloud=$(docker image inspect \
    --format '{{range .Config.Env}}{{println .}}{{end}}' "$image_reference" | \
    sed -n 's/^RP_IMAGE_CLOUD=//p')
  [[ -n "$expected_cloud" && "$image_cloud" == "$expected_cloud" ]] || {
    echo "candidate image provider does not match RP_CLOUD" >&2
    return 1
  }
  printf '%s\n' "$image_reference"
}

case "$action" in
  validate)
    validate_layout
    compose config --quiet
    ;;
  candidate-preflight)
    candidate_preflight
    ;;
  image-reference)
    validate_layout
    compose config --quiet
    compose config --images | sort -u
    ;;
  stop)
    stop_project
    ;;
  health)
    health false
    ;;
  wait)
    wait_seconds=${3:-300}
    [[ "$wait_seconds" =~ ^[1-9][0-9]*$ ]] || usage
    deadline=$((SECONDS + wait_seconds))
    until health true; do
      if (( SECONDS >= deadline )); then
        health false || true
        exit 1
      fi
      sleep 5
    done
    health false
    ;;
  migration-preflight)
    run_migration_container \
      "$migration_tag_env" migration-preflight "$start_timeout" migration_compose
    ;;
  migration-current)
    run_migration_container \
      "$candidate_tag_env" migration-current "$start_timeout" candidate_compose
    ;;
  schema-current)
    run_migration_container \
      "$tag_env" migration-current "$start_timeout" compose
    ;;
  migrate)
    run_migration_container \
      "$migration_tag_env" migration "$migration_timeout" migration_compose
    ;;
  supervise)
    start_project
    trap 'exit 0' INT TERM
    failures=0
    while true; do
      sleep "$health_interval" &
      wait $! || exit 0
      if health true; then
        failures=0
      else
        failures=$((failures + 1))
        logger -t "jarvis-compose-${role}" "health check failed (${failures}/${health_failures_allowed})"
        if (( failures >= health_failures_allowed )); then
          health false || true
          exit 1
        fi
      fi
    done
    ;;
esac
