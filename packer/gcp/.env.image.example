# Copy to .env.image, replace every placeholder, and chmod 600.
PKR_VAR_project_id=REPLACE_WITH_GCP_PROJECT_ID
PKR_VAR_zone=us-central1-a
PKR_VAR_subnetwork=projects/REPLACE_WITH_GCP_PROJECT_ID/regions/us-central1/subnetworks/REPLACE_WITH_SUBNETWORK
PKR_VAR_source_image=REPLACE_WITH_EXACT_DEBIAN_12_IMAGE_NAME
PKR_VAR_image_name=jarvis-host-REPLACE_WITH_12_CHAR_GIT_SHA-REPLACE_WITH_UTC_YYYYMMDDHHMM
PKR_VAR_git_revision=REPLACE_WITH_FULL_40_CHAR_GIT_SHA
PKR_VAR_docker_engine_version=REPLACE_WITH_EXACT_DOCKER_CE_VERSION
PKR_VAR_docker_cli_version=REPLACE_WITH_EXACT_DOCKER_CE_CLI_VERSION
PKR_VAR_containerd_version=REPLACE_WITH_EXACT_CONTAINERD_IO_VERSION
PKR_VAR_buildx_version=REPLACE_WITH_EXACT_DOCKER_BUILDX_PLUGIN_VERSION
PKR_VAR_compose_version=REPLACE_WITH_EXACT_DOCKER_COMPOSE_PLUGIN_VERSION
PKR_VAR_docker_repo_key_sha256=REPLACE_WITH_REVIEWED_DOCKER_REPOSITORY_KEY_SHA256
PKR_VAR_ops_agent_version=REPLACE_WITH_EXACT_OPS_AGENT_VERSION
PKR_VAR_ops_agent_installer_sha256=REPLACE_WITH_REVIEWED_INSTALLER_SHA256
PKR_VAR_rsync_version=REPLACE_WITH_EXACT_DEBIAN_RSYNC_VERSION

# Identity references, not credential material. ADC must be configured first.
# Uncomment after the first full environment apply creates the deployer.
# GOOGLE_IMPERSONATE_SERVICE_ACCOUNT=research-REPLACE_WITH_ENV-deployer@REPLACE_WITH_GCP_PROJECT_ID.iam.gserviceaccount.com
# CLOUDSDK_AUTH_IMPERSONATE_SERVICE_ACCOUNT=research-REPLACE_WITH_ENV-deployer@REPLACE_WITH_GCP_PROJECT_ID.iam.gserviceaccount.com
